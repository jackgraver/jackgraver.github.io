---
// Light/dark toggle. Rendered once per panel (top-right) so both are visible
// while the panels slide past each other. All instances stay in sync via the
// shared script in index.astro (they're found by [data-theme-toggle]).
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode">
  <svg class="sun" viewBox="0 0 24 24" width="33" height="33" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="33" height="33" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: absolute;
    top: 4px;
    right: 4px;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    padding: 0;
    color: var(--mute);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s;
  }
  .theme-toggle:hover { color: var(--ink); }
  .theme-toggle svg { grid-area: 1 / 1; transition: opacity 0.25s, transform 0.4s; }

  /* Show the icon for the mode you'd switch TO: a moon in light mode, a sun in dark mode. */
  .sun { opacity: 0; transform: rotate(-60deg) scale(0.6); }
  :global([data-theme="dark"]) .sun { opacity: 1; transform: none; }
  :global([data-theme="dark"]) .moon { opacity: 0; transform: rotate(60deg) scale(0.6); }
</style>
